import json
import os

class I18N:
    SUPPORTED_LOCALES = ['en', 'hi', 'pa']
    LOCALES_DIR = 'static/locales'

    def __init__(self):
        self.locale = 'en'
        self.data = {}

    def load(self, lang: str):
        """Load JSON for a locale, cache it, then apply it."""
        if lang not in self.SUPPORTED_LOCALES:
            lang = 'en'

        if lang not in self.data:
            path = os.path.join(self.LOCALES_DIR, f'{lang}.json')
            try:
                with open(path, 'r', encoding='utf-8') as f:
                    self.data[lang] = json.load(f)
            except (FileNotFoundError, json.JSONDecodeError) as e:
                print(f'i18n load failed: {e}')
                return

        self.locale = lang

    def t(self, key: str, fallback: str = None) -> str:
        """Translate a dot-path key e.g. t('nav.home')"""
        if fallback is None:
            fallback = key

        parts = key.split('.')
        obj = self.data.get(self.locale, {})

        for part in parts:
            if not isinstance(obj, dict):
                return fallback
            obj = obj.get(part)
            if obj is None:
                return fallback

        return obj if obj is not None else fallback


# Global instance + shorthand
i18n = I18N()

def t(key: str, fallback: str = None) -> str:
    return i18n.t(key, fallback)
